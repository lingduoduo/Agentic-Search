# Java (required for BM25 indexing via pyserini — must point to an arm64 JDK on Apple Silicon)
# brew install openjdk  →  /opt/homebrew/opt/openjdk/libexec/openjdk.jdk/Contents/Home
JAVA_HOME=

# OpenMP (macOS Apple Silicon only — prevents segfault when PyTorch and FAISS are loaded together)
# Required only if faiss-cpu was installed via pip instead of conda.
# conda install -c conda-forge faiss-cpu is the preferred install method on macOS.
KMP_DUPLICATE_LIB_OK=TRUE

# Google Custom Search
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# SerpAPI
SERP_API_KEY=

# Server bind addresses (optional — defaults shown)
GOOGLE_SEARCH_HOST=0.0.0.0
GOOGLE_SEARCH_PORT=8000
SERP_SEARCH_HOST=0.0.0.0
SERP_SEARCH_PORT=8000
RERANK_SERVER_HOST=0.0.0.0
RERANK_SERVER_PORT=6980
RETRIEVAL_SERVER_HOST=0.0.0.0
RETRIEVAL_SERVER_PORT=8000
